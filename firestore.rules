rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "mathelaureate@gmail.com";
    }

    // Dedicated copy-paste editor account — create-only, never update/delete.
    // Keep this email in sync with VITE_EDITOR_EMAIL in the app env.
    function isContentEditor() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == "editor.mathelaureate@gmail.com";
    }

    match /userPayments/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // App-level config docs (curricula, paywall, IA, etc.).
    match /appData/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Course content shown to students.
    match /courseContentItems/{docId} {
      allow read: if true;
      allow create: if isAdmin() || isContentEditor();
      allow update, delete: if isAdmin();
    }

    // Per-user progress and profile-style state.
    match /userCourseProgress/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Default deny for all other documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
